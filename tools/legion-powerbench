#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# legion-powerbench - measure which limit is actually binding, before changing one.
#
# This is deliberately NOT a subcommand of legion-powerctl. The polkit policy pins
# exec.path to the CLI, so a long-running, load-generating subcommand would widen what a
# retained auth_admin_keep grant can reach. This script samples unprivileged and shells
# out to legion-powerctl for anything that needs privilege.
#
# See docs/TUNING.md for the protocol this implements.

set -Eeuo pipefail
shopt -s nullglob

readonly VERSION="0.3.0"
readonly PROGRAM="${0##*/}"

readonly HWMON_ROOT="${LEGION_POWERBENCH_HWMON_ROOT:-/sys/class/hwmon}"
readonly POWER_SUPPLY_ROOT="${LEGION_POWERBENCH_POWER_SUPPLY_ROOT:-/sys/class/power_supply}"
readonly TURBOSTAT_BIN="${LEGION_POWERBENCH_TURBOSTAT_BIN:-turbostat}"
readonly NVIDIA_SMI_BIN="${LEGION_POWERBENCH_NVIDIA_SMI_BIN:-nvidia-smi}"
readonly RYZENADJ_BIN="${LEGION_POWERBENCH_RYZENADJ_BIN:-ryzenadj}"
readonly CLI_BIN="${LEGION_POWERBENCH_CLI_BIN:-legion-powerctl}"
readonly SUDO_BIN="${LEGION_POWERBENCH_SUDO_BIN:-sudo}"
readonly STRESS_NG_BIN="${LEGION_POWERBENCH_STRESS_NG_BIN:-stress-ng}"
readonly OPENSSL_BIN="${LEGION_POWERBENCH_OPENSSL_BIN:-openssl}"
readonly VKMARK_BIN="${LEGION_POWERBENCH_VKMARK_BIN:-vkmark}"
readonly GLMARK2_BIN="${LEGION_POWERBENCH_GLMARK2_BIN:-glmark2}"
readonly BENCH_PROFILE="${LEGION_POWERBENCH_PROFILE_NAME:-powerbench}"

# Thresholds behind the limiter table in docs/TUNING.md section 2.
readonly TEMP_HEADROOM_C="${LEGION_POWERBENCH_TEMP_HEADROOM_C:-5}"
readonly POWER_PIN_TOL_W="${LEGION_POWERBENCH_POWER_PIN_TOL_W:-3}"
readonly GAIN_MIN_PCT="${LEGION_POWERBENCH_GAIN_MIN_PCT:-2}"

readonly CSV_HEADER='step,phase,elapsed_s,stapm_w,slow_w,fast_w,temp_c,tctl_c,tccd_c,pkg_w,bzy_mhz,busy_pct,fan_rpm,gpu_w,gpu_limit_w,gpu_temp_c,gpu_util_pct,throughput'

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    readonly C_RED=$'\033[31m' C_YELLOW=$'\033[33m' C_GREEN=$'\033[32m'
    readonly C_CYAN=$'\033[36m' C_RESET=$'\033[0m'
else
    readonly C_RED="" C_YELLOW="" C_GREEN="" C_CYAN="" C_RESET=""
fi

info()    { printf '%s%s%s\n' "$C_CYAN" "$*" "$C_RESET" >&2; }
success() { printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET" >&2; }
warn()    { printf '%sWARNING:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()     { printf '%sERROR:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

SAMPLE_INTERVAL=5
DRY_RUN=0
RESTORE_PROFILE=""
STEP_STAPM="" STEP_SLOW="" STEP_FAST="" STEP_TEMP=""

usage() {
    cat <<'EOF_USAGE'
legion-powerbench - measure which power or thermal limit is actually binding

Usage:
  legion-powerbench doctor
  legion-powerbench sample [--duration S] [--interval S] [--out FILE]
  legion-powerbench run --ladder stapm|temp --from N --to N [--step N]
                        [--workload cpu|crossload|none] [--workload-cmd CMD]
                        [--soak S] [--cool S] [--interval S] [--temp C]
                        [--out FILE] [--dry-run]
  legion-powerbench report FILE
  legion-powerbench version

Run options:
  --ladder NAME       Which dimension to step: stapm (watts) or temp (Celsius)
  --from N --to N     Inclusive range for the ladder
  --step N            Ladder increment (default 10 for stapm, 5 for temp)
  --temp C            Fixed TEMP_C while laddering stapm (default 85)
  --workload NAME     cpu, crossload, or none (default cpu)
  --workload-cmd CMD  Any command to run as the load, instead of a preset
  --soak S            Seconds of load per step (default 600)
  --cool S            Seconds of cooldown between steps (default 300)
  --interval S        Seconds between samples (default 5)
  --out FILE          CSV output (default powerbench-<ladder>.csv)
  --dry-run           Print the plan and every command; change and load nothing

A run applies its steps through a scratch profile named 'powerbench' and restores the
previously active profile when it finishes, including on interrupt.

See docs/TUNING.md for the protocol, the stop rules, and how to read the result.
EOF_USAGE
}

# ---------------------------------------------------------------- source probing

TEMP_SOURCE="" TEMP_HWMON="" TCCD_HWMON=""
PKG_SOURCE="" FAN_SOURCE="" GPU_SOURCE=""

hwmon_named() {
    local want="$1" dir
    for dir in "$HWMON_ROOT"/hwmon*; do
        [[ -r "$dir/name" ]] || continue
        if [[ "$(<"$dir/name")" == "$want" ]]; then
            printf '%s' "$dir"
            return 0
        fi
    done
    return 1
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

detect_sources() {
    TEMP_HWMON="$(hwmon_named k10temp || true)"
    if [[ -n "$TEMP_HWMON" && -r "$TEMP_HWMON/temp1_input" ]]; then
        TEMP_SOURCE=k10temp
        TCCD_HWMON="$TEMP_HWMON"
    else
        TEMP_SOURCE=none
    fi

    if have_cmd "$TURBOSTAT_BIN" && [[ -n "$(turbostat_read 1 2>/dev/null || true)" ]]; then
        PKG_SOURCE=turbostat
    elif have_cmd "$RYZENADJ_BIN" && ryzenadj_value 'STAPM VALUE' >/dev/null 2>&1; then
        PKG_SOURCE=ryzenadj
    elif battery_watts >/dev/null 2>&1; then
        PKG_SOURCE=battery
    else
        PKG_SOURCE=none
    fi

    FAN_SOURCE=none
    local dir file
    for dir in "$HWMON_ROOT"/hwmon*; do
        for file in "$dir"/fan[0-9]_input; do
            FAN_SOURCE="$file"
            break 2
        done
    done

    if have_cmd "$NVIDIA_SMI_BIN" && [[ -n "$(gpu_sample 2>/dev/null || true)" ]]; then
        GPU_SOURCE=nvidia-smi
    else
        GPU_SOURCE=none
    fi
}

# ---------------------------------------------------------------- readers

milli_to_unit() {
    awk -v v="${1:-}" 'BEGIN { if (v == "") exit 1; printf "%.1f", v / 1000 }'
}

read_tctl() {
    [[ "$TEMP_SOURCE" == k10temp ]] || return 1
    milli_to_unit "$(<"$TEMP_HWMON/temp1_input")"
}

# The hottest Tccd. Tccd runs above Tctl by design; it is recorded so a ceiling that
# looks breached can be recognised as not breached. See docs/TUNING.md section 3.
read_tccd() {
    [[ -n "$TCCD_HWMON" ]] || return 1
    local label file best="" value
    for label in "$TCCD_HWMON"/temp*_label; do
        [[ -r "$label" ]] || continue
        [[ "$(<"$label")" == Tccd* ]] || continue
        file="${label%_label}_input"
        [[ -r "$file" ]] || continue
        value="$(<"$file")"
        if [[ -z "$best" ]] || (( value > best )); then best="$value"; fi
    done
    [[ -n "$best" ]] || return 1
    milli_to_unit "$best"
}

# One turbostat measurement over the sample interval. Doubles as the pacing sleep.
turbostat_read() {
    local interval="${1:-1}"
    "$SUDO_BIN" -n "$TURBOSTAT_BIN" --quiet --Summary \
        --show PkgWatt,Bzy_MHz,Busy% -- sleep "$interval" 2>/dev/null |
        awk '
            NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
            NR == 2 {
                printf "%s %s %s\n",
                    (col["PkgWatt"] ? $col["PkgWatt"] : ""),
                    (col["Bzy_MHz"] ? $col["Bzy_MHz"] : ""),
                    (col["Busy%"]   ? $col["Busy%"]   : "")
                exit
            }'
}

# ryzenadj -i rows are "| Name | Value | Parameter |". The VALUE rows carry an empty
# parameter column, so they can only be matched on the Name column - unlike the LIMIT
# rows, which the CLI matches by parameter.
ryzenadj_value() {
    local want="$1" report value
    report="$("$RYZENADJ_BIN" -i 2>/dev/null)" || return 1
    value="$(awk -F'|' -v want="$want" '
        {
            name = $2; gsub(/^[ \t]+|[ \t]+$/, "", name)
            if (name == want) {
                v = $3; gsub(/^[ \t]+|[ \t]+$/, "", v)
                print v
                exit
            }
        }' <<<"$report")"
    [[ -n "$value" ]] || return 1
    printf '%s' "$value"
}

battery_watts() {
    local dir
    for dir in "$POWER_SUPPLY_ROOT"/BAT*; do
        [[ -r "$dir/power_now" ]] || continue
        awk -v v="$(<"$dir/power_now")" \
            'BEGIN { if (v + 0 <= 0) exit 1; printf "%.1f", v / 1000000 }' && return 0
    done
    return 1
}

read_fan() {
    [[ "$FAN_SOURCE" != none && -r "$FAN_SOURCE" ]] || return 1
    cat "$FAN_SOURCE"
}

gpu_sample() {
    "$NVIDIA_SMI_BIN" \
        --query-gpu=power.draw,enforced.power.limit,temperature.gpu,utilization.gpu \
        --format=csv,noheader,nounits 2>/dev/null |
        head -n1 | tr -d ' ' | awk -F, 'NF >= 4 { print $1, $2, $3, $4 }'
}

# ---------------------------------------------------------------- sampling

# Emits one CSV row. The caller owns pacing except under turbostat, which measures over
# the interval and therefore consumes it.
sample_row() {
    local step="$1" phase="$2" elapsed="$3" throughput="${4:-}"
    local tctl tccd pkg bzy busy fan gpu_w gpu_lim gpu_t gpu_u

    tctl="$(read_tctl 2>/dev/null || true)"
    tccd="$(read_tccd 2>/dev/null || true)"
    fan="$(read_fan 2>/dev/null || true)"

    pkg="" bzy="" busy=""
    case "$PKG_SOURCE" in
        turbostat) read -r pkg bzy busy <<<"$(turbostat_read "$SAMPLE_INTERVAL" || true)" ;;
        ryzenadj)  pkg="$(ryzenadj_value 'STAPM VALUE' 2>/dev/null || true)"; sleep "$SAMPLE_INTERVAL" ;;
        battery)   pkg="$(battery_watts 2>/dev/null || true)"; sleep "$SAMPLE_INTERVAL" ;;
        *)         sleep "$SAMPLE_INTERVAL" ;;
    esac

    gpu_w="" gpu_lim="" gpu_t="" gpu_u=""
    if [[ "$GPU_SOURCE" == nvidia-smi ]]; then
        read -r gpu_w gpu_lim gpu_t gpu_u <<<"$(gpu_sample || true)"
    fi

    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "$step" "$phase" "$elapsed" \
        "$STEP_STAPM" "$STEP_SLOW" "$STEP_FAST" "$STEP_TEMP" \
        "${tctl:-}" "${tccd:-}" "${pkg:-}" "${bzy:-}" "${busy:-}" "${fan:-}" \
        "${gpu_w:-}" "${gpu_lim:-}" "${gpu_t:-}" "${gpu_u:-}" "$throughput"
}

sample_for() {
    local step="$1" phase="$2" duration="$3" out="$4"
    local elapsed=0
    while (( elapsed < duration )); do
        sample_row "$step" "$phase" "$elapsed" >> "$out"
        elapsed=$(( elapsed + SAMPLE_INTERVAL ))
    done
}

# ---------------------------------------------------------------- workloads

resolve_workload() {
    local kind="$1" duration="$2"
    case "$kind" in
        none) printf 'sleep %s' "$duration" ;;
        cpu|crossload)
            if have_cmd "$STRESS_NG_BIN"; then
                printf '%s --cpu 0 --cpu-method matrixprod --timeout %ss --metrics-brief' \
                    "$STRESS_NG_BIN" "$duration"
            elif have_cmd "$OPENSSL_BIN"; then
                printf '%s speed -seconds %s -multi %s sha256' \
                    "$OPENSSL_BIN" "$duration" "$(nproc 2>/dev/null || printf 1)"
            else
                warn "Neither stress-ng nor openssl was found; using the portable busy-loop fallback. Its throughput number is comparable only against itself."
                printf 'busy_loop %s' "$duration"
            fi
            ;;
        *) die "Unknown workload '$kind'. Use cpu, crossload, or none." ;;
    esac
}

resolve_gpu_workload() {
    local duration="$1"
    if have_cmd "$VKMARK_BIN"; then
        printf '%s --run-forever' "$VKMARK_BIN"
    elif have_cmd "$GLMARK2_BIN"; then
        printf '%s --run-forever' "$GLMARK2_BIN"
    else
        warn "No vkmark or glmark2 found; this crossload run carries no GPU load and measures the CPU-only class instead."
        printf 'sleep %s' "$duration"
    fi
}

busy_loop() {
    local duration="$1" jobs i
    jobs="$(nproc 2>/dev/null || printf 1)"
    local -a pids=()
    for (( i = 0; i < jobs; i++ )); do
        ( local_count=0; end=$(( SECONDS + duration ))
          while (( SECONDS < end )); do local_count=$(( local_count + 1 )); done
          printf '%s\n' "$local_count" ) &
        pids+=("$!")
    done
    wait "${pids[@]}" 2>/dev/null || true
}

# Throughput is only ever as good as what the workload itself reports. stress-ng's
# metrics-brief table is parsed properly; anything else falls back to the last bare
# number printed, which is a guess and is documented as one.
extract_throughput() {
    local log="$1" value
    [[ -r "$log" ]] || return 0
    value="$(awk '$2 == "cpu" && NF >= 6 && $6 ~ /^[0-9.]+$/ { print $6 }' "$log" | tail -n1)"
    if [[ -z "$value" ]]; then
        value="$(grep -Eo '[0-9]+\.?[0-9]*' "$log" 2>/dev/null | tail -n1 || true)"
    fi
    printf '%s' "${value:-}"
}

run_load() {
    local cmd="$1"
    if [[ "$cmd" == busy_loop* ]]; then
        busy_loop "${cmd#busy_loop }"
    else
        bash -c "$cmd"
    fi
}

# ---------------------------------------------------------------- privileged calls

active_profile() {
    "$CLI_BIN" status --json 2>/dev/null |
        grep -o '"active_profile":"[^"]*"' | head -n1 | cut -d'"' -f4
}

apply_step() {
    local stapm="$1" slow="$2" fast="$3" temp="$4"
    if (( DRY_RUN )); then
        printf 'DRY-RUN: %s configure %s --stapm %s --slow %s --fast %s --temp %s --apply\n' \
            "$CLI_BIN" "$BENCH_PROFILE" "$stapm" "$slow" "$fast" "$temp" >&2
        return 0
    fi
    "$SUDO_BIN" "$CLI_BIN" configure "$BENCH_PROFILE" \
        --stapm "$stapm" --slow "$slow" --fast "$fast" --temp "$temp" \
        --description "legion-powerbench scratch profile; see docs/TUNING.md" \
        --apply >/dev/null
}

restore_profile() {
    local profile="$RESTORE_PROFILE"
    [[ -n "$profile" && "$profile" != "$BENCH_PROFILE" ]] || return 0
    if (( DRY_RUN )); then
        printf 'DRY-RUN: %s apply %s\n' "$CLI_BIN" "$profile" >&2
        return 0
    fi
    info "Restoring profile '$profile'."
    "$SUDO_BIN" "$CLI_BIN" apply "$profile" >/dev/null 2>&1 ||
        warn "Could not restore profile '$profile'. Run: sudo $CLI_BIN apply $profile"
}

# ---------------------------------------------------------------- commands

DOCTOR_RC=0
doctor_line() {
    local state="$1" name="$2" detail="$3" colour="$C_GREEN"
    case "$state" in
        WARN) colour="$C_YELLOW"; (( DOCTOR_RC < 1 )) && DOCTOR_RC=1 ;;
        FAIL) colour="$C_RED"; DOCTOR_RC=2 ;;
    esac
    printf '%s%-4s%s %-16s %s\n' "$colour" "$state" "$C_RESET" "$name" "$detail"
}

cmd_doctor() {
    detect_sources
    DOCTOR_RC=0

    if [[ "$TEMP_SOURCE" == k10temp ]]; then
        doctor_line OK Tctl "k10temp at $TEMP_HWMON, reads $(read_tctl) C"
    else
        doctor_line FAIL Tctl "no k10temp hwmon under $HWMON_ROOT; temperature cannot be measured"
    fi

    local tccd
    tccd="$(read_tccd 2>/dev/null || true)"
    if [[ -n "$tccd" ]]; then
        doctor_line OK Tccd "reads $tccd C; expected to sit above Tctl"
    else
        doctor_line WARN Tccd "no Tccd label found; only Tctl will be recorded"
    fi

    case "$PKG_SOURCE" in
        turbostat) doctor_line OK Package-power "turbostat" ;;
        ryzenadj)  doctor_line WARN Package-power "ryzenadj metrics table; turbostat is more reliable on Zen. Install linux-tools and allow '$SUDO_BIN -n $TURBOSTAT_BIN'" ;;
        battery)   doctor_line WARN Package-power "battery power_now only; whole-system, and reads zero on AC" ;;
        *)         doctor_line FAIL Package-power "no source; power-limited and thermally limited cannot be told apart" ;;
    esac

    if [[ "$FAN_SOURCE" != none ]]; then
        doctor_line OK Fan "$FAN_SOURCE"
    else
        doctor_line WARN Fan "no fan*_input under $HWMON_ROOT; a Legion platform driver is not loaded"
    fi

    if [[ "$GPU_SOURCE" == nvidia-smi ]]; then
        doctor_line OK GPU "nvidia-smi, read only"
    else
        doctor_line WARN GPU "nvidia-smi unavailable; crossload runs cannot be interpreted"
    fi

    local loads="" tool
    for tool in "$STRESS_NG_BIN" "$OPENSSL_BIN" "$VKMARK_BIN" "$GLMARK2_BIN"; do
        if have_cmd "$tool"; then loads="$loads ${tool##*/}"; fi
    done
    if [[ -n "$loads" ]]; then
        doctor_line OK Workloads "available:$loads"
    else
        doctor_line WARN Workloads "none found; the busy-loop fallback is comparable only against itself"
    fi

    if have_cmd "$CLI_BIN"; then
        doctor_line OK CLI "$CLI_BIN, active profile '$(active_profile || printf unknown)'"
    else
        doctor_line FAIL CLI "$CLI_BIN not found; a ladder cannot change limits"
    fi

    return "$DOCTOR_RC"
}

cmd_sample() {
    local duration=60 out=""
    while (( $# > 0 )); do
        case "$1" in
            --duration) duration="${2:?--duration needs a value}"; shift ;;
            --interval) SAMPLE_INTERVAL="${2:?--interval needs a value}"; shift ;;
            --out) out="${2:?--out needs a value}"; shift ;;
            -h|--help) usage; return 0 ;;
            *) die "Unknown sample option: $1" ;;
        esac
        shift
    done
    detect_sources
    if [[ "$PKG_SOURCE" == none && "$TEMP_SOURCE" == none ]]; then
        die "No telemetry source at all. Run '$PROGRAM doctor'."
    fi

    local target="${out:-/dev/stdout}"
    printf '%s\n' "$CSV_HEADER" > "$target"
    sample_for idle sample "$duration" "$target"
    if [[ -n "$out" ]]; then
        success "Wrote $out"
    fi
    return 0
}

cmd_run() {
    local ladder="" from="" to="" step="" workload=cpu workload_cmd=""
    local soak=600 cool=300 fixed_temp=85 out=""
    while (( $# > 0 )); do
        case "$1" in
            --ladder) ladder="${2:?--ladder needs a value}"; shift ;;
            --from) from="${2:?--from needs a value}"; shift ;;
            --to) to="${2:?--to needs a value}"; shift ;;
            --step) step="${2:?--step needs a value}"; shift ;;
            --temp) fixed_temp="${2:?--temp needs a value}"; shift ;;
            --workload) workload="${2:?--workload needs a value}"; shift ;;
            --workload-cmd) workload_cmd="${2:?--workload-cmd needs a value}"; shift ;;
            --soak) soak="${2:?--soak needs a value}"; shift ;;
            --cool) cool="${2:?--cool needs a value}"; shift ;;
            --interval) SAMPLE_INTERVAL="${2:?--interval needs a value}"; shift ;;
            --out) out="${2:?--out needs a value}"; shift ;;
            --dry-run) DRY_RUN=1 ;;
            -h|--help) usage; return 0 ;;
            *) die "Unknown run option: $1" ;;
        esac
        shift
    done

    [[ -n "$ladder" ]] || die "run requires --ladder stapm or --ladder temp."
    [[ -n "$from" && -n "$to" ]] || die "run requires --from and --to."
    case "$ladder" in
        stapm) step="${step:-10}" ;;
        temp)  step="${step:-5}" ;;
        *) die "Unknown ladder '$ladder'. Use stapm or temp." ;;
    esac
    (( from <= to )) || die "--from must not exceed --to."
    (( step > 0 )) || die "--step must be positive."
    out="${out:-powerbench-$ladder.csv}"

    detect_sources
    if (( ! DRY_RUN )); then
        if [[ "$PKG_SOURCE" == none ]]; then
            warn "No package-power source. The ladder will run, but 'power limited' cannot be distinguished from 'thermally limited'. Run '$PROGRAM doctor'."
        fi
        RESTORE_PROFILE="$(active_profile || true)"
        trap 'restore_profile; exit 130' INT TERM
        trap 'restore_profile' EXIT
    fi

    printf '%s\n' "$CSV_HEADER" > "$out"

    info "Ladder: $ladder $from..$to by $step, soak ${soak}s, cool ${cool}s, interval ${SAMPLE_INTERVAL}s"
    info "Telemetry: temp=$TEMP_SOURCE power=$PKG_SOURCE fan=${FAN_SOURCE##*/} gpu=$GPU_SOURCE"

    local value label log throughput cmd gpu_cmd gpu_pid load_pid
    for (( value = from; value <= to; value += step )); do
        if [[ "$ladder" == stapm ]]; then
            STEP_STAPM="$value"
            STEP_TEMP="$fixed_temp"
        else
            STEP_STAPM="$from"
            STEP_TEMP="$value"
        fi
        STEP_SLOW=$(( STEP_STAPM + 5 ))
        STEP_FAST=$(( STEP_STAPM + 15 ))
        label="${ladder}-${value}"

        info "Step $label: ${STEP_STAPM}/${STEP_SLOW}/${STEP_FAST} W, ${STEP_TEMP} C"
        apply_step "$STEP_STAPM" "$STEP_SLOW" "$STEP_FAST" "$STEP_TEMP"

        cmd="${workload_cmd:-$(resolve_workload "$workload" "$soak")}"
        if (( DRY_RUN )); then
            printf 'DRY-RUN: baseline %ss, load %ss with: %s, cooldown %ss\n' \
                "$SAMPLE_INTERVAL" "$soak" "$cmd" "$cool" >&2
            continue
        fi

        sample_for "$label" baseline "$SAMPLE_INTERVAL" "$out"

        log="$(mktemp)"
        gpu_pid=""
        if [[ "$workload" == crossload && -z "$workload_cmd" ]]; then
            gpu_cmd="$(resolve_gpu_workload "$soak")"
            run_load "$gpu_cmd" >/dev/null 2>&1 &
            gpu_pid=$!
        fi
        run_load "$cmd" > "$log" 2>&1 &
        load_pid=$!
        sample_for "$label" load "$soak" "$out"
        wait "$load_pid" 2>/dev/null || true
        if [[ -n "$gpu_pid" ]]; then
            kill "$gpu_pid" 2>/dev/null || true
            wait "$gpu_pid" 2>/dev/null || true
        fi

        throughput="$(extract_throughput "$log")"
        rm -f "$log"
        sample_row "$label" summary "$soak" "$throughput" >> "$out"

        if (( cool > 0 )); then
            sample_for "$label" cooldown "$cool" "$out"
        fi
    done

    if (( DRY_RUN )); then
        success "Dry run complete; nothing was applied or loaded."
        return 0
    fi
    success "Wrote $out"
    info "Now run: $PROGRAM report $out"
    return 0
}

cmd_report() {
    local file="${1:?usage: $PROGRAM report FILE}"
    [[ -r "$file" ]] || die "Cannot read '$file'."

    awk -F, -v tol="$POWER_PIN_TOL_W" -v head="$TEMP_HEADROOM_C" -v gain="$GAIN_MIN_PCT" '
        function classify(s, t, p) {
            if (t == "" || p == "") return "inconclusive: missing telemetry, run doctor"
            if (ceiling[s] != "" && t >= ceiling[s] - 1)
                return "thermally limited: Tctl is at the ceiling, more power will not help"
            if (stapm[s] != "" && p >= stapm[s] - tol && t <= ceiling[s] - head)
                return "power limited by your own cap: headroom exists, raise STAPM"
            if (stapm[s] != "" && p < stapm[s] - tol)
                return "neither cap binds: a current or firmware limit sits below yours"
            return "mixed: neither signature is clean, extend the soak"
        }
        NR == 1 { next }
        $2 == "load" {
            s = $1
            if (!(s in order)) { order[s] = ++steps; name[steps] = s }
            if ($8 != "") { t_sum[s] += $8; t_n[s]++ }
            if ($10 != "") { p_sum[s] += $10; p_n[s]++ }
            if ($13 != "") { f_sum[s] += $13; f_n[s]++ }
            if ($14 != "") { g_sum[s] += $14; g_n[s]++ }
            stapm[s] = $4; ceiling[s] = $7
        }
        $2 == "summary" { tp[$1] = $18 }
        END {
            if (steps == 0) { print "No load samples in this file."; exit 1 }
            printf "%-14s %-11s %-7s %-7s %-7s %-7s %-12s %-9s\n", \
                "STEP", "LIMITS", "TCTL", "PKG_W", "FAN", "GPU_W", "THROUGHPUT", "PER_WATT"
            prev_tp = 0; stop = 0
            for (i = 1; i <= steps; i++) {
                s = name[i]
                t = t_n[s] ? t_sum[s] / t_n[s] : ""
                p = p_n[s] ? p_sum[s] / p_n[s] : ""
                f = f_n[s] ? f_sum[s] / f_n[s] : ""
                g = g_n[s] ? g_sum[s] / g_n[s] : ""
                pw = (tp[s] != "" && p != "" && p > 0) ? tp[s] / p : ""
                printf "%-14s %-11s %-7s %-7s %-7s %-7s %-12s %-9s\n", s, \
                    stapm[s] "W/" ceiling[s] "C", \
                    (t != "" ? sprintf("%.1f", t) : "-"), \
                    (p != "" ? sprintf("%.1f", p) : "-"), \
                    (f != "" ? sprintf("%.0f", f) : "-"), \
                    (g != "" ? sprintf("%.1f", g) : "-"), \
                    (tp[s] != "" ? tp[s] : "-"), \
                    (pw != "" ? sprintf("%.2f", pw) : "-")
                verdict[i] = classify(s, t, p)
                if (tp[s] != "" && prev_tp > 0) {
                    delta = 100 * (tp[s] - prev_tp) / prev_tp
                    if (delta < gain && stop == 0) { stop = i; stop_delta = delta }
                }
                if (tp[s] != "") prev_tp = tp[s]
            }
            printf "\nVERDICT\n"
            for (i = 1; i <= steps; i++) printf "  %-14s %s\n", name[i], verdict[i]
            if (stop > 0)
                printf "\n  Throughput gain fell to %.1f%% at %s, below the %s%% stop rule.\n", \
                    stop_delta, name[stop], gain
            printf "\n  docs/TUNING.md section 2 explains each verdict, section 6 the stop rules.\n"
        }
    ' "$file"
}

main() {
    local command="${1:-help}"
    (( $# > 0 )) && shift
    case "$command" in
        doctor|check) cmd_doctor "$@" ;;
        sample) cmd_sample "$@" ;;
        run) cmd_run "$@" ;;
        report) cmd_report "$@" ;;
        version|--version|-V) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
        help|--help|-h) usage ;;
        *) die "Unknown command '$command'. Run '$PROGRAM help'." ;;
    esac
}

main "$@"
