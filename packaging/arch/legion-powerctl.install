pre_install() {
    rm -f /var/lib/legion-powerctl/fresh-config
    if [ ! -e /etc/legion-powerctl/config.conf ] && [ ! -L /etc/legion-powerctl/config.conf ]; then
        mkdir -p /var/lib/legion-powerctl && : > /var/lib/legion-powerctl/fresh-config || true
    fi
}

post_install() {
    cat <<'EOF'
legion-powerctl writes volatile CPU SMU power limits through RyzenAdj.
Use at your own risk. Not affiliated with Lenovo, AMD, or CachyOS;
Legion is a trademark of Lenovo.

The package itself enables nothing. Boot persistence comes from:

    legion-powerctl doctor
    sudo legion-powerctl enable    # runs doctor first; --force skips the gate

(./install.sh runs this enable step for you unless --no-enable was given.)
Fire Range / HX CPUs need ryzenadj 0.19.0 or newer.

The optional ryzen_smu-dkms-git exposes /sys/kernel/ryzen_smu_drv. RyzenAdj
needs a compatible driver and PM-table files to use it for applying limits.
EOF
    if [ ! -e /var/lib/legion-powerctl/fresh-config ]; then
        printf '\nKept the existing boot profile in /etc/legion-powerctl/config.conf.\n'
        return 0
    fi
    rm -f /var/lib/legion-powerctl/fresh-config
    if legion-powerctl select balanced >/dev/null 2>&1; then
        printf '\nThe boot profile is balanced. Nothing was applied.\n'
    else
        printf '\nCould not select balanced for boot. Run: sudo legion-powerctl select balanced\n'
    fi
}

pre_remove() {
    systemctl disable --now legion-powerctl.service >/dev/null 2>&1 || true
    # Written by ./install.sh --install-ryzen-smu, so no package owns it. Left behind
    # it outlives ryzen_smu-dkms-git and fails systemd-modules-load.service on every
    # boot, and the uninstall.sh that would clear it refuses to run for package installs.
    if [ -e /etc/modules-load.d/legion-powerctl.conf ]; then
        rm -f /etc/modules-load.d/legion-powerctl.conf
        printf 'Removed /etc/modules-load.d/legion-powerctl.conf. The ryzen_smu module itself was not removed.\n'
    fi
}

boot_profile() {
    sed -n 's/^[[:space:]]*ACTIVE_PROFILE[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' \
        /etc/legion-powerctl/config.conf 2>/dev/null | tail -n 1
}

pre_upgrade() {
    rm -f /var/lib/legion-powerctl/pre-upgrade-boot
    active="$(boot_profile)"
    [ -n "$active" ] || return 0
    mkdir -p /var/lib/legion-powerctl && printf '%s\n' "$active" > /var/lib/legion-powerctl/pre-upgrade-boot || true
}

post_upgrade() {
    cat <<'EOF'
If you edited the bundled profiles, check for .pacnew files under
/etc/legion-powerctl. Reapply the active profile with:

    sudo legion-powerctl apply
EOF
    saved=""
    [ ! -f /var/lib/legion-powerctl/pre-upgrade-boot ] || saved="$(head -n 1 /var/lib/legion-powerctl/pre-upgrade-boot)"
    rm -f /var/lib/legion-powerctl/pre-upgrade-boot
    active="$(boot_profile)"
    if [ -n "$saved" ] && [ "$saved" != "$active" ] && [ "$active" = balanced-plus ]; then
        case "$saved" in
            powerbench-*)
                printf '\nThe upgrade replaced the boot profile %s with %s. %s is a temporary benchmark profile, so it was not selected again.\n' \
                    "$saved" "$active" "$saved"
                ;;
            *)
                if [ -f "/etc/legion-powerctl/profiles.d/$saved.conf" ] &&
                    legion-powerctl show "$saved" >/dev/null 2>&1; then
                    if legion-powerctl select "$saved" >/dev/null 2>&1; then
                        printf '\nThe upgrade replaced the boot profile %s with %s; selected %s again. Nothing was applied.\n' \
                            "$saved" "$active" "$saved"
                        active="$saved"
                    else
                        printf '\nThe upgrade replaced the boot profile %s with %s. Restore it with: sudo legion-powerctl select %s\n' \
                            "$saved" "$active" "$saved"
                    fi
                fi
                ;;
        esac
    fi
    if [ -n "$active" ] && [ ! -e "/etc/legion-powerctl/profiles.d/$active.conf" ]; then
        printf '\nThe boot profile %s no longer exists. Select another one:\n\n    sudo legion-powerctl select balanced --apply\n' "$active"
    fi
}
