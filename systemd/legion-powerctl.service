[Unit]
Description=Apply configurable Lenovo Legion Ryzen CPU limits once at boot
Documentation=file:///usr/share/doc/legion-powerctl/README.md
After=systemd-modules-load.service dbus.service power-profiles-daemon.service
ConditionFileIsExecutable=/usr/bin/legion-powerctl

[Service]
Type=oneshot
ExecStart=/usr/bin/legion-powerctl apply --boot
RemainAfterExit=yes
# The first boot apply records the firmware's own SMU limits here, before it
# overwrites them. The CLI sets its own umask and writes every file with an explicit
# mode, so UMask below does not apply to them: 'baseline --show' and 'status' are
# read-only queries and do not need root.
StateDirectory=legion-powerctl
StateDirectoryMode=0755
TimeoutStartSec=30s
# ProtectSystem stays "full", not "strict": this writes CPUFreq/EPP sysfs and
# /run/legion-powerctl, and RyzenAdj needs /dev/mem or a usable ryzen_smu sysfs interface. Do not
# add ProtectKernelTunables - it blocks the sysfs writes this service exists for.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
# The unit shells out to ryzenadj and powerprofilesctl and writes sysfs; it never
# opens a socket beyond the powerprofilesctl D-Bus connection on AF_UNIX.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
SystemCallArchitectures=native
# @raw-io alongside @system-service: RyzenAdj reaches the SMU through /dev/mem or the
# ryzen_smu sysfs interface, and some builds fall back to port I/O, which needs iopl/ioperm.
SystemCallFilter=@system-service @raw-io
SystemCallErrorNumber=EPERM
UMask=0077
# Deliberately NOT set: CapabilityBoundingSet and DeviceAllow. Both would have to be
# proven against a real SMU write on the laptop, and getting them wrong fails the
# boot apply silently. Tighten them once there is a verified boot.

[Install]
WantedBy=multi-user.target
