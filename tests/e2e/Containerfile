# SPDX-License-Identifier: MIT
# Everything `make check-strict` and `make test-e2e` need, in one image, because this
# repository is developed on hosts that have neither PySide6 nor the xcb stack and the
# recipe for that image was living in a scratch directory.
FROM docker.io/library/python:3.12-slim

# Unpinned by default, so this image tests the PySide6 CI tests; pass
# --build-arg PYSIDE6='PySide6==6.11.1' to reproduce a specific failure.
ARG PYSIDE6=PySide6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        make git shellcheck fish \
        libegl1 libopengl0 libxkbcommon0 libgl1 libdbus-1-3 \
        libfontconfig1 libfreetype6 fonts-dejavu-core hicolor-icon-theme \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xkb1 libxkbcommon-x11-0 libxrender1 libsm6 libice6 \
        xvfb xauth x11-utils xdotool openbox dbus-x11 \
        at-spi2-core python3-gi gir1.2-atspi-2.0 python3-pyatspi \
    && (apt-get install -y --no-install-recommends libglib2.0-0t64 \
        || apt-get install -y --no-install-recommends libglib2.0-0) \
    && rm -rf /var/lib/apt/lists/*

# Into /usr/local/bin/python3, this image's own: that is the python3 the launcher finds
# on PATH and execs, so it is the interpreter the application runs on. /usr/bin/python3
# is Debian's, and it is the only one that can have python3-pyatspi - that is the
# driver. They share a bus and nothing else.
RUN pip install --no-cache-dir "$PYSIDE6" ruff

ENV LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1
WORKDIR /src
